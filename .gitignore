# =====================================================
# Enclave — .gitignore
# =====================================================

# ---------- Python ----------
__pycache__/
*.py[cod]
*$py.class
*.so
*.egg-info/
*.egg
.eggs/

# ---------- 虛擬環境 ----------
.venv/
venv/
env/
ENV/

# ---------- 測試快取 ----------
.pytest_cache/
.coverage
htmlcov/
.tox/
.mypy_cache/

# ---------- 環境變數（只保留 .env.example）----------
.env
.env.local
.env.development
.env.staging
.env.production
.env.test
.env.*.local

# ---------- 上傳資料（保留目錄結構）----------
uploads/*
!uploads/.gitkeep

# ---------- Connector 憑證（不得進 uploads／備份）----------
var/credentials/*
!var/credentials/.gitkeep
var/bookstack_app_key.txt

# ---------- 本機備份產出（含真實資料，不入庫）----------
backups/

# ---------- 測試產出（保留目錄結構）----------
test-results/*
!test-results/.gitkeep
test-uploads/*
!test-uploads/.gitkeep

# ---------- 大型測試資料（不入庫，用 scripts 或 README 說明如何取得）----------
testdata/
test-data/

# ---------- 效能基準測試快取 ----------
.benchmarks/

# ---------- 開發日誌 ----------
artifacts/logs/*
!artifacts/logs/.gitkeep

# ---------- 執行產物 / 發布驗證輸出 ----------
# 基準資料與人工校對資料可另行明確納管；每次執行產生的輸出不得成為原始碼。
artifacts/**/*_last_run.json
artifacts/_*.txt
artifacts/ops/*
!artifacts/ops/.gitkeep
artifacts/knowledge/external_acceptance_handoff_*/
artifacts/knowledge/browser_developer_preflight_*.json
artifacts/knowledge/deployment_manifest.json
artifacts/knowledge/migration_offline.sql
artifacts/knowledge/production_*_probe.json
artifacts/knowledge/*check*.txt
artifacts/knowledge/worktree_status_*.txt
artifacts/release/
artifacts/sbom/*
!artifacts/sbom/.gitkeep
artifacts/security/*
!artifacts/security/.gitkeep

# ---------- 一次性診斷／探針（不得成為正式來源）----------
scripts/_*.py
scripts/_*.sh
scripts/repro_quota_tx.py
test-materials/e2e/_probe_out.json
test-materials/e2e/*_report.json

# ---------- 編輯器 / IDE ----------
.vscode/
.idea/
*.swp
*.swo
*~

# ---------- 作業系統 ----------
.DS_Store
Thumbs.db
._*

# ---------- 前端建置產出 ----------
dist/
build/
node_modules/
*.log
*.tsbuildinfo

# ---------- Docker ----------
*.tar

# ---------- 其他 ----------
*.bak
*.tmp
