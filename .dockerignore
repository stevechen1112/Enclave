# =====================================================
# Enclave — .dockerignore
# =====================================================
.git
.github
.venv
venv
__pycache__
*.pyc
*.pyo
.pytest_cache
.mypy_cache
.ruff_cache

# Frontend (not needed in backend image)
frontend/
admin-frontend/
node_modules

.env
.env.*
!.env.example
!.env.*.example

# Non-essential
uploads/*
docs/
scripts/
tests/
artifacts/
artifacts_eval/
test-agent-watch/
test-data/
test-materials/
test-results/
test-uploads/
testdata/
.benchmarks/
.cache/
.cursor/
var/
backups/
htmlcov/
coverage.xml
*.md
*.log
.DS_Store
.vscode/
.idea/

# Strict backend build allowlist. Docker evaluates the last matching rule,
# so only production runtime inputs below may reach `COPY . .`.
*
!.dockerignore
!Dockerfile
!requirements.txt
!requirements.lock.txt
!alembic.ini
!celery_worker.py
!app/
!app/**
!docker/
!docker/**
!configs/
!configs/**
!config/
!config/tenant_security_catalog.json
!config/tenant_session_exceptions.json
!scripts/
!scripts/provision_tenant_database_roles.py
!scripts/tenant_security_gate.py
!scripts/tenant_session_context_gate.py
!scripts/rls_shadow_report.py
