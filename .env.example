# ══════════════════════════════════════════
#  Enclave — 企業私有 AI 知識大腦
#  環境設定範本（複製為 .env 後修改）
# ══════════════════════════════════════════

# ── 基本設定 ──
APP_NAME=Enclave
ORGANIZATION_NAME=我的組織
APP_ENV=production
DEMO_LOGIN_ENABLED=false
DEMO_ACCESS_TOKEN_EXPIRE_MINUTES=60
# 由 scripts/demo_tenant.py 建立；啟用時必須完全等於這個合成租戶 UUID。
DEMO_TENANT_ID=4a8a6ec2-9be7-5d43-a786-2bf4af10f3d1
DEMO_ADMIN_EMAIL=admin-door@demo.enclave.invalid
# 啟用六道門時兩者都必須 true；一般客戶環境可依授權方案設定。
FIXED_FORM_ENABLED=false
KNOWHOW_CARD_ENABLED=false
MODULE_ROUTER_ENABLED=true
# 部署是否包含 MKA pack；各租戶仍須另外建立 TenantModuleBinding。
PACK_MKA_ENABLED=true
PACK_SALES_QUOTE_ENABLED=true
PACK_INCIDENT_HANDOVER_ENABLED=true
PACK_QUALITY_8D_ENABLED=true
PACK_TRAINING_KNOWHOW_ENABLED=true

# ── 受治理影片匯入（部署能力；租戶權限仍由平台授權與 ACL 控制）──
VIDEO_INGESTION_ENABLED=true
VIDEO_MAX_BYTES=524288000
VIDEO_MAX_SECONDS=3600
VIDEO_MAX_WIDTH=3840
VIDEO_MAX_HEIGHT=2160
VIDEO_MAX_KEYFRAMES=24
VIDEO_KEYFRAME_MIN_INTERVAL_SECONDS=15
VIDEO_AUDIO_CHUNK_SECONDS=300
VIDEO_ALLOWED_CODECS=h264,hevc,vp8,vp9,av1
MEDIA_PROXY_ENABLED=true
MEDIA_PROXY_MAX_WIDTH=1280
MEDIA_PROXY_VIDEO_BITRATE=1800k
AUDIO_CHUNK_SECONDS=300
AUDIO_MAX_SECONDS=14400
AUDIO_ALLOWED_CODECS=mp3,pcm_s16le,pcm_s24le,pcm_s32le,pcm_f32le,pcm_f64le,aac,vorbis,flac,opus,alac,amr_nb,amr_wb
MEDIA_PROCESSING_THREADS=1
INGESTION_STALE_AFTER_SECONDS=1800
INGESTION_MAX_ATTEMPTS=3
API_V1_STR=/api/v1
# 請使用強隨機字串（至少 32 字元），可執行 python scripts/dev/gen_hash.py 產生
SECRET_KEY=change_this_to_a_secure_random_string_at_least_32_chars
FIRST_SUPERUSER_EMAIL=admin@enclave.local
FIRST_SUPERUSER_PASSWORD=請立即修改此密碼

# ── LLM 設定（三選一）──
# 選項 A：Google Gemini（推薦，性價比高）
LLM_PROVIDER=gemini
GEMINI_API_KEY=AIza...
GEMINI_MODEL=gemini-3-flash-preview
# 選項 B：OpenAI API
# LLM_PROVIDER=openai
# OPENAI_API_KEY=sk-...
# OPENAI_MODEL=gpt-4o-mini
# VOICE_REALTIME_ENABLED=false
# VOICE_REALTIME_MODEL=gpt-realtime-2.1
# VOICE_REALTIME_VOICE=marin
# LONG_INTERVIEW_STT_MODEL=gpt-4o-transcribe-diarize
# 選項 C：Ollama 本機 LLM（零 API 費用，需要較強硬體）
# LLM_PROVIDER=ollama
# OLLAMA_BASE_URL=http://host.docker.internal:11434
# OLLAMA_MODEL=llama3.2

# 回答來源稽核：off | shadow | enforce（大小寫與前後空白會正規化，其他值拒絕啟動）
SOURCE_VERIFY_MODE=off
# KnowledgeUnit 權威切換：shadow 只比對；取得簽核證據後才可設 enforce。
KNOWLEDGE_UNIT_READ_MODE=shadow
# 預設只建立 RLS policy，不 FORCE；需依 docs/runbooks/RLS_AUTHORITY_ROLLOUT.md 完成 gate。
RLS_ENFORCEMENT_ENABLED=false

# KQ7 canonical decision rollout（預設 off；allowlist 不等於 Owner 授權）。
KNOWLEDGE_DECISION_MODE=off
KNOWLEDGE_DECISION_TENANT_ALLOWLIST=
KNOWLEDGE_DECISION_KILL_SWITCH=false
KNOWLEDGE_DECISION_AUTHORIZATION_REQUIRED=true
KNOWLEDGE_DECISION_AUTHORIZATION_KEY=
KNOWLEDGE_DECISION_KB_REVISION_ID=
KNOWLEDGE_DECISION_RELEASE_ID=
KNOWLEDGE_DECISION_PACK_VERSIONS={}
KNOWLEDGE_DECISION_PROMPT_VERSION=
KNOWLEDGE_DECISION_ROLLBACK_POINT=
ENCLAVE_BACKEND_IMAGE_DIGEST=unknown
ENCLAVE_FRONTEND_IMAGE_DIGEST=unknown

# ── 向量嵌入設定 ──
VOYAGE_API_KEY=voyage-...
VOYAGE_MODEL=voyage-4-lite

# ── 文件解析設定 ──
LLAMAPARSE_ENABLED=true
LLAMAPARSE_API_KEY=
LLAMAPARSE_LANGUAGE=zh-TW
OCR_LANGS=chi_tra+eng

# ── RAGFlow DeepDOC（掃描件正式路徑）──
# RAGFLOW_ENABLED=true
# RAGFLOW_BASE_URL=http://ragflow:9380  # 容器內使用 service DNS；正式環境禁止 localhost
# RAGFLOW_API_KEY=
# RAGFLOW_DATASET_ID=          # 必填；空值時掃描件 DeepDOC 入庫會失敗（不再靜默 fallback）
# RAGFLOW_FORCE_PARSE=false
# RAGFLOW_PARSE_POLL_ATTEMPTS=36
# RAGFLOW_PARSE_POLL_SLEEP_S=5
# PIPESHUB_ENABLED=false
# PIPESHUB_BASE_URL=http://pipeshub-api:3000
# WEKNORA_ENABLED=false
# WEKNORA_BASE_URL=http://weknora:8080

# ── 掃描件交付閘門（預設開啟）──
# native/text_fallback 不得標 completed；雲端 OCR 未救回則入庫 failed。
# SCAN_PARSE_STRICT=true

# ── 雲端 OCR 增強臂（選配；建議掃描件環境開啟）──
# 觸發：字數過少 / text_fallback / DeepDOC 路由但未 OCR / 髒 OCR 啟發式（間隔字元）。
# 消融依據見 docs/CAPABILITY_ACTIVATION_AND_VALUE_PROOF_PLAN.md（CV-RF-01b 五臂）。
# CLOUD_OCR_PROVIDER=gemini            # openai | gemini | mistral
# CLOUD_OCR_MODEL=gemini-3-flash-preview   # 留空用各 provider 預設
# CLOUD_OCR_TRIGGER_MIN_CHARS=200

# ── 資料庫（PostgreSQL）──
POSTGRES_SERVER=db
POSTGRES_USER=postgres
POSTGRES_PASSWORD=請修改此密碼
POSTGRES_DB=enclave
# FORCE RLS 專用維運登入；不可與 web/worker 的 POSTGRES_USER 共用。
MAINTENANCE_POSTGRES_USER=enclave_maintenance
MAINTENANCE_POSTGRES_PASSWORD=請使用另一組強密碼

# ── Redis（任務佇列）──
REDIS_HOST=redis
REDIS_PORT=6379
REDIS_PASSWORD=

# ── Phase 10: Agent 自動索引 ──
AGENT_WATCH_ENABLED=false
# 多個資料夾以半形逗號分隔（容器內路徑）
AGENT_WATCH_FOLDERS=
AGENT_WATCH_TENANT_ID=
AGENT_WATCH_USER_ID=
AGENT_BATCH_HOUR=2
AGENT_MAX_CPU_PERCENT=50.0

# ── Phase 11: 內容生成 ──
GENERATION_MAX_TOKENS=3000

# ── 觀測（CG-OBS：Sentry + Langfuse，未設定時自動停用）──
# SENTRY_DSN=
# SENTRY_ENVIRONMENT=production
# SENTRY_TRACES_SAMPLE_RATE=0.1
# LANGFUSE_ENABLED=false
# LANGFUSE_SECRET_KEY=
# LANGFUSE_PUBLIC_KEY=
# LANGFUSE_HOST=https://cloud.langfuse.com

# ── 上傳掃毒（CG-CLAMAV；SaaS／託管必開，地端可關）──
# CLAMAV_ENABLED=false
# CLAMAV_HOST=clamav
# CLAMAV_PORT=3310
# CLAMAV_FAIL_CLOSED=true

# ── 金流（CG-PAY NewebPay；未設 MERCHANT_ID 時 checkout 回 503）──
# NEWEBPAY_MERCHANT_ID=
# NEWEBPAY_HASH_KEY=
# NEWEBPAY_HASH_IV=
# NEWEBPAY_TEST_MODE=true
# BACKEND_BASE_URL=http://localhost:8000

# ── 開發者 OAuth（自己的測試 App，不是客戶憑證）──
# 說明：docs/runbooks/DEV_OAUTH_SETUP.md
# SHAREPOINT_TENANT_ID=
# SHAREPOINT_CLIENT_ID=
# SHAREPOINT_CLIENT_SECRET=
# SHAREPOINT_SITE_URL=
# GOOGLE_CLIENT_ID=
# GOOGLE_CLIENT_SECRET=
# GOOGLE_REFRESH_TOKEN=
# Legacy HR-only deterministic rules. Keep false for domain-neutral Enclave.
HR_COMPATIBILITY_PACK_ENABLED=false
